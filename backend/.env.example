# ── Google Gemini ────────────────────────────────────────────────────
# Required for live AI triage. Get a key at https://aistudio.google.com/apikey
# Copy this file to .env and fill it in. Never commit the real key.
#   cp .env.example .env
GEMINI_API_KEY=

# Optional. A Flash-class model is the sensible default for this workload:
# short-context classification and structured extraction.
# GEMINI_MODEL=gemini-3.6-flash
